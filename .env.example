# ============================================================================
# SAP BTP Generative AI Hub & AI Core Configuration
# Copy this file to .env and populate with your SAP AI Core service key values:
#   cp .env.example .env
# ============================================================================

# LiteLLM provider for SAP Generative AI Hub
LITELLM_PROVIDER=sap

# SAP AI Core OAuth2 & API credentials (from generative-ai-hub service key)
AICORE_AUTH_URL=https://<your-subdomain>.authentication.<region>.hana.ondemand.com
AICORE_CLIENT_ID=<your-aicore-client-id>
AICORE_CLIENT_SECRET=<your-aicore-client-secret>
AICORE_BASE_URL=https://api.ai.prod.<region>.aws.ml.hana.ondemand.com/v2
AICORE_RESOURCE_GROUP=ai-agents-codejam

# SAP-RPT-1 Tabular Model Deployment
RPT1_DEPLOYMENT_URL=https://api.ai.prod.<region>.aws.ml.hana.ondemand.com/v2/inference/deployments/<deployment-id>/predict
RPT1_MODEL_NAME=sap-rpt-1-large

# SAP Document Grounding Service (Vector Pipeline ID from SAP AI Launchpad)
GROUNDING_PIPELINE_ID=0d3b132a-cbe1-4c75-abe7-adfbbab7e002
GROUNDING_MAX_CHUNKS=5

# Optional: Set to "true" to search local ./data/documents/*.txt files
# if you want to test the Evidence Analyst locally without a Vector Grounding pipeline
USE_LOCAL_EVIDENCE_FALLBACK=false

# CrewAI & A2A Server Settings
CREWAI_TRACING_ENABLED=false
PORT=8080
# Optional explicit public URL for the A2A AgentCard (auto-resolved on Cloud Foundry via VCAP_APPLICATION)
# APP_URL=https://investigator-crew.cfapps.eu10-004.hana.ondemand.com
